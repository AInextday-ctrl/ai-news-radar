        ]
      },
      {
        "source": "/articles/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/zh/articles/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/zh",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=120, s-maxage=600, stale-while-revalidate=1800"
