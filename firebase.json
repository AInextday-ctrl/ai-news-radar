        "destination": "/zh/privacy.html"
      },
      {
        "source": "/zh/privacy/",
        "destination": "/zh/privacy.html"
      },
      {
        "source": "/zh/terms",
        "destination": "/zh/terms.html"
      },
      {
        "source": "/zh/terms/",
        "destination": "/zh/terms.html"
      },
      {
        "source": "/zh/dmca",
        "destination": "/zh/dmca.html"
      },
      {
        "source": "/zh/dmca/",
        "destination": "/zh/dmca.html"
      },
      {
        "source": "/zh/articles",
        "destination": "/zh/articles/index.html"
      },
      {
        "source": "/zh/articles/",
        "destination": "/zh/articles/index.html"
      },
      {
        "source": "/zh/daily",
        "destination": "/zh/daily/index.html"
