          }
        ]
      },
      {
        "source": "/m/js/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/m/css/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/data/archive/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, stale-while-revalidate=600"
          }
        ]
      },
      {
        "source": "**/data/archive_*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/data/latest_news.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=120, stale-while-revalidate=600"
          }
        ]
      },
      {
        "source": "**/data/curated_column_highlights.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=120, stale-while-revalidate=600"
          }
        ]
      },
      {
        "source": "**/data/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=180, stale-while-revalidate=300"
          }
        ]
      },
      {
        "source": "**/*sitemap*.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=1800, stale-while-revalidate=3600"
          }
        ]
      },
      {
        "source": "**/feed*.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/rss+xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=900, stale-while-revalidate=1800"
          }
        ]
      },
      {
        "source": "**/rss*.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/rss+xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=900, stale-while-revalidate=1800"
          }
        ]
      },
      {
        "source": "**/feed.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=900, stale-while-revalidate=1800"
          }
        ]
      },
      {
        "source": "**/llms*.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=1800, stale-while-revalidate=3600"
          }
        ]
      },
      {
        "source": "robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
