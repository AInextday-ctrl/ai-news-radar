{
  "hosting": {
    "site": "ai-radar-news",
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/master_archive.json",
      "**/processed_news_ledger.json",
      "**/apify_crawler_state.json",
      "**/tweet_tags_cache.json",
      "**/*.tmp"
    ],
    "rewrites": [
      {
        "source": "/zh",
        "destination": "/zh/index.html"
      },
      {
        "source": "/zh/",
        "destination": "/zh/index.html"
      },
      {
        "source": "/zh/about",
        "destination": "/zh/about.html"
      },
      {
        "source": "/zh/about/",
        "destination": "/zh/about.html"
      },
      {
        "source": "/zh/editorial-policy",
        "destination": "/zh/editorial-policy.html"
      },
      {
        "source": "/zh/editorial-policy/",
        "destination": "/zh/editorial-policy.html"
      },
      {
        "source": "/zh/contact",
        "destination": "/zh/contact.html"
      },
      {
        "source": "/zh/contact/",
        "destination": "/zh/contact.html"
      },
      {
        "source": "/zh/privacy",
        "destination": "/zh/privacy.html"
      },
      {
        "source": "/zh/privacy/",
        "destination": "/zh/privacy.html"
      },
      {
        "source": "/zh/terms",
        "destination": "/zh/terms.html"
      },
      {
        "source": "/zh/terms/",
        "destination": "/zh/terms.html"
      },
      {
        "source": "/zh/articles",
        "destination": "/zh/articles/index.html"
      },
      {
        "source": "/zh/articles/",
        "destination": "/zh/articles/index.html"
      },
      {
        "source": "/zh/daily",
        "destination": "/zh/daily/index.html"
      },
      {
        "source": "/zh/daily/",
        "destination": "/zh/daily/index.html"
      },
      {
        "source": "/zh/tools/:id",
        "destination": "/zh/tools/:id.html"
      },
      {
        "source": "/zh/tools",
        "destination": "/zh/tools/index.html"
      },
      {
        "source": "/zh/tools/",
        "destination": "/zh/tools/index.html"
      },
      {
        "source": "/zh/news/:id",
        "destination": "/zh/news/:id.html"
      },
      {
        "source": "/zh/news",
        "destination": "/zh/news/index.html"
      },
      {
        "source": "/zh/news/",
        "destination": "/zh/news/index.html"
      },
      {
        "source": "/tools/:id",
        "destination": "/tools/:id.html"
      },
      {
        "source": "/tools",
        "destination": "/tools/index.html"
      },
      {
        "source": "/tools/",
        "destination": "/tools/index.html"
      },
      {
        "source": "/news/:id",
        "destination": "/news/:id.html"
      },
      {
        "source": "/news",
        "destination": "/news/index.html"
      },
      {
        "source": "/news/",
        "destination": "/news/index.html"
      },
      {
        "source": "/zh/**",
        "destination": "/zh/index.html"
      },
      {
        "source": "/articles",
        "destination": "/articles/index.html"
      },
      {
        "source": "/articles/",
        "destination": "/articles/index.html"
      },
      {
        "source": "/daily",
        "destination": "/daily/index.html"
      },
      {
        "source": "/daily/",
        "destination": "/daily/index.html"
      },
      {
        "source": "/wechat",
        "destination": "/wechat.html"
      },
      {
        "source": "/wechat/",
        "destination": "/wechat.html"
      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/about/",
        "destination": "/about.html"
      },
      {
        "source": "/contact",
        "destination": "/contact.html"
      },
      {
        "source": "/contact/",
        "destination": "/contact.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/privacy/",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/terms/",
        "destination": "/terms.html"
      },
      {
        "source": "/editorial-policy",
        "destination": "/editorial-policy.html"
      },
      {
        "source": "/editorial-policy/",
        "destination": "/editorial-policy.html"
      },
      {
        "source": "/go",
        "destination": "/go.html"
      },
      {
        "source": "/go/**",
        "destination": "/go.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|mjs)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(svg|png|jpg|jpeg|webp|gif|ico|woff|woff2|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, stale-while-revalidate=600"
          }
        ]
      },
      {
        "source": "**/data/archive_*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/data/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=180, stale-while-revalidate=300"
          }
        ]
      },
      {
        "source": "sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, stale-while-revalidate=7200"
          }
        ]
      },
      {
        "source": "robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}