{
  "hosting": {
    "site": "ai-radar-news",
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/master_archive.json",
      "**/processed_news_ledger.json",
      "**/apify_crawler_state.json",
      "**/tweet_tags_cache.json",
      "**/*.tmp"
    ],
    "rewrites": [
      {
        "source": "/zh/m",
        "destination": "/zh/m/index.html"
