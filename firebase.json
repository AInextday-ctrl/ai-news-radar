      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/about/",
        "destination": "/about.html"
      },
      {
        "source": "/contact",
        "destination": "/contact.html"
      },
      {
        "source": "/contact/",
        "destination": "/contact.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/privacy/",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/terms/",
        "destination": "/terms.html"
      },
      {
        "source": "/dmca",
        "destination": "/dmca.html"
      },
      {
        "source": "/dmca/",
        "destination": "/dmca.html"
      },
      {
        "source": "/editorial-policy",
        "destination": "/editorial-policy.html"
      },
      {
        "source": "/editorial-policy/",
        "destination": "/editorial-policy.html"
      },
      {
        "source": "/go",
        "destination": "/go.html"
      },
      {
        "source": "/go/**",
        "destination": "/go.html"
      }
    ],
    "headers": [
      {
        "source": "**/js/*-v*.min.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/css/*-v*.min.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|mjs)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(svg|png|jpg|jpeg|webp|gif|ico|woff|woff2|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, stale-while-revalidate=1200"
          }
        ]
      },
      {
        "source": "/news/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/zh/news/**",
        "headers": [
          {
            "key": "Cache-Control",
